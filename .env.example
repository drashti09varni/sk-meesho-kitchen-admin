# UPI collection (same configuration as Kitchan)
PAYTM_UPI_ID=your-vpa@paytm
PAYTM_MERCHANT_NAME=Store
PHONEPE_MERCHANT_NAME=Store

# Optional for manual UPI switching. API verification requires a supported
# merchant integration that registers the same order reference with Paytm.
PAYTM_MID=
# PAYTM_ENV=test

# Optional Meta Pixel IDs
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_EXTRA_PIXELS=

# Persistent UPI management (optional until configured; never expose to browser)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PAYMENT_ADMIN_PASSWORD=
PAYMENT_ADMIN_SESSION_SECRET=
