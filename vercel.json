{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    { "src": "/admin/payments/?", "dest": "/payment-admin.html" },
    { "handle": "filesystem" },
    { "src": "/(?:assets|api)(?:/.*)?", "status": 404 },
    { "src": "/.*\\.[^/]+$", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
